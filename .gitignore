cases/**/processor*/
cases/**/postProcessing/
cases/**/log.*
cases/**/[0-9]*.[0-9]*/

# --- Rendered reference pages (regenerable from PDFs via ref/extract_pdfs.py) ---
ref/pages/

# --- Generated geometry (regenerable from aircraft.yaml + toolkit) ---
*.stl
