// Kinematic viscosity from aircraft.yaml (atmosphere.kinematic_viscosity,
// ISA sea level). The 2D convention is c = 1 m and U = Re * nu / c, so with
// THIS nu the chord Reynolds number reproduces the requested Re = @RE@
// exactly: Re_check = U * c / nu = @U_MAG@ * 1 / @NU@.

transportModel  Newtonian;

nu              [0 2 -1 0 0 0 0] @NU@;

