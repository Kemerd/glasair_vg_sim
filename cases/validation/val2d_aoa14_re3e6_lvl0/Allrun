#!/bin/bash
# -----------------------------------------------------------------------------
#  Allrun -- Phase-1 clean-section 2D validation case val2d_aoa14_re3e6_lvl0
#  Target environment: WSL2 Ubuntu, ESI OpenFOAM v2506 (package openfoam2506).
#  The case is dry-run friendly: if no OpenFOAM environment is found this
#  script explains itself and exits nonzero without touching anything.
# -----------------------------------------------------------------------------
set -e
cd "$(dirname "$0")"

# Pick up the pinned toolkit when the shell is not already inside an OpenFOAM
# environment. The path below is where the Ubuntu openfoam2506 package lands.
if [ -z "$WM_PROJECT" ]; then
    OF_BASHRC="/usr/lib/openfoam/openfoam2506/etc/bashrc"
    if [ -f "$OF_BASHRC" ]; then
        # shellcheck disable=SC1090
        . "$OF_BASHRC"
    else
        echo "Allrun: no OpenFOAM environment active and $OF_BASHRC not found."
        echo "Allrun: install ESI OpenFOAM v2506 (apt package openfoam2506) in WSL2,"
        echo "Allrun: or source its etc/bashrc first. Case files are ready to run."
        exit 1
    fi
fi

# Mesh, then verify it: checkMesh failures here are mesh-generator bugs and
# must stop the pipeline before any solver time is burned.
blockMesh > log.blockMesh 2>&1
checkMesh > log.checkMesh 2>&1

# 8-rank decomposition per system/decomposeParDict (scotch).
decomposePar -force > log.decomposePar 2>&1

# Steady SIMPLE solve; residualControl in fvSolution stops it once every
# residual is below the spec gate with margin. See README.md for the
# documented pimpleFoam pseudo-transient fallback at post-stall AoA.
mpirun -np 8 simpleFoam -parallel > log.simpleFoam 2>&1

# Reassemble for post-processing (BL profile sets, yPlus field, fields).
reconstructPar -latestTime > log.reconstructPar 2>&1

echo "Allrun: complete. Histories in postProcessing/, logs in log.*"
