/*--------------------------------*- C++ -*----------------------------------*\
|  Turbulent viscosity -- Phase-1 clean-section 2D validation case            |
|  Instantiated from cases/validation_2d/template by                          |
|  scripts/build_validation_case.py                                           |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// nut is a DERIVED field (the model computes it from k and omega); only the
// wall entry is a real modelling decision here.

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    airfoil
    {
        // Low-Re wall treatment: NO nut wall function. With y+ < 1 the
        // viscous sublayer is resolved and turbulent viscosity vanishes at
        // the wall by definition; a nutkWallFunction here would inject a
        // log-law assumption that contradicts the wall-resolved mesh AND
        // corrupt the laminar regions the kOmegaSSTLM transition model is
        // supposed to predict (a wall function presumes turbulent flow).
        type            fixedValue;
        value           uniform 0;
    }

    farfield
    {
        // Computed from the local k/omega solution at the boundary.
        type            calculated;
        value           uniform 0;
    }

    outlet
    {
        type            calculated;
        value           uniform 0;
    }

    frontAndBack
    {
        // 2D empty direction.
        type            empty;
    }
}

