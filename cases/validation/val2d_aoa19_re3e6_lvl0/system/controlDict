/*--------------------------------*- C++ -*----------------------------------*\
|  controlDict -- pimpleFoam pseudo-transient VARIANT (post-stall fallback)   |
|  Lives in pimple_overrides/; copied over system/controlDict by              |
|  scripts/run_validation.py when a post-stall case refuses to converge      |
|  steady. Identical to the base dictionary except where commented.           |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Pseudo-transient fallback: pimpleFoam with localEuler time stepping (the
// ddt swap lives in the sibling fvSchemes override). Post-stall the steady
// SIMPLE iteration fights the shedding the physics wants; local pseudo-time
// marching lets each cell relax at its own stable rate toward the (mean)
// solution instead. The gate report flags these points as pseudo-transient
// (validation/compare_gate.py reads 'application' from this file).

application     pimpleFoam;                 // VARIANT: was simpleFoam

startFrom       latestTime;
startTime       0;

stopAt          endTime;

// Under localEuler the global time index is just an outer-iteration
// counter, so deltaT 1 / endTime 6000 keep the meaning they had in the
// steady run: an iteration budget, not physical seconds.
endTime         6000;

deltaT          1;

writeControl    timeStep;
writeInterval   1000;

// Keep only the last two snapshots: intermediate fields are restart
// insurance, not results; forces/residuals/yPlus histories are written
// every step by the function objects below regardless.
purgeWrite      2;

writeFormat     ascii;
writePrecision  8;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable true;

functions
{
    // Same function-object set as the steady run -- the post-processing
    // chain (forces, residuals, y+, BL profiles, wall Cf) must not change
    // across the solver swap or the gate inputs would stop being
    // comparable.
    #include "forceCoeffs"
    #include "residuals"
    #include "yPlusObj"
    #include "sampling"
    #include "wallShearStressObj"
}

// ************************************************************************* //
